# ---------------------------------------------------------------
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git
# ---------------------------------------------------------------

# Neon PostgreSQL Connection String
# Get this from: https://console.neon.tech → Your Project → Connection Details
# Format: postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://neondb_owner:YOUR_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Environment (development | production)
ENVIRONMENT=development
