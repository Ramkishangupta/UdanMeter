# ==============================================================================
# MoSPI Real-time Airfare Price Index (APIx) - Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Update the values below according to your deployment or local setup.
# 3. NEVER commit the real '.env' file containing secrets to version control!
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# Database Configuration (PostgreSQL vs SQLite)
# ==============================================================================
# For Local Development with SQLite:
# Leave DATABASE_URL blank or comment it out, and the backend will automatically 
# use local SQLite file 'apix_database.db'.
# DATABASE_URL=

# --- PostgreSQL Connection Options (Pick one for Production) ---
# Option 1: Neon Serverless PostgreSQL (Recommended Free Tier)
# Get from: https://console.neon.tech -> Connection Details
# DATABASE_URL=postgresql+psycopg2://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Supabase PostgreSQL (Free Tier)
# Get from: https://app.supabase.com -> Project Settings -> Database -> URI
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require

# Option 3: Render PostgreSQL (Internal or External URL)
# DATABASE_URL=postgresql+psycopg2://apix_user:YOUR_PASSWORD@dpg-xxxx-a.oregon-postgres.render.com/apix_db

# Option 4: Local Docker / Native PostgreSQL
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/apix_db

# ==============================================================================
# Security & CORS Settings
# ==============================================================================
# Allowed frontend origins (comma-separated). Use * for open development.
# In production, set this to your exact Vercel / Netlify frontend domain:
# CORS_ORIGINS=https://udanmeter.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880    # 5 MB per rotated log file
LOG_BACKUP_COUNT=5       # Keep up to 5 archive logs (apix_server.log.1, etc.)

DATABASE_URL="postgresql://neondb_owner:npg_3bg1fwqkyesz@ep-red-sound-b45vxwhe.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
